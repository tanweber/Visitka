# Скопируйте в .env и поправьте под себя. Все строки необязательны:
# без .env сервис стартует с логином admin / паролем admin (сменить при первом входе).
# Copy to .env and adjust. Every line is optional: without .env the service starts
# with admin / admin and asks to change the password on first login.

# Внешний адрес, по которому сервис открывают люди и телефоны (показывается в интерфейсе
# и в инструкции для DAVx5). Пусто — берётся адрес из запроса.
# Public URL shown in the UI and DAVx5 instructions. Empty = taken from the request.
PUBLIC_URL=https://contacts.example.com

# Первый администратор: создаётся один раз, когда база пуста.
# First administrator, created once when the database is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Ключ подписи сессий. Пусто — сгенерируется и сохранится в томе app_data.
# Session signing key. Empty = generated once and stored in the app_data volume.
# openssl rand -base64 48
SECRET_KEY=

# Порт Caddy на хосте; TLS обычно терминирует внешний обратный прокси.
# Host port for Caddy; TLS is usually terminated by an external reverse proxy.
CADDY_HTTP_PORT=8080

# Secure-cookie: auto (по PUBLIC_URL с https), 1 или 0.
# Secure cookies: auto (on when PUBLIC_URL is https), 1 or 0.
COOKIE_SECURE=auto

# Язык интерфейса: auto (по браузеру), ru или en. / UI language: auto, ru or en.
DEFAULT_LANG=auto

# Имя адресной книги на телефонах (пусто — «Контакты», при DEFAULT_LANG=en — «Contacts»).
# Address book name on phones (empty = "Контакты", or "Contacts" with DEFAULT_LANG=en).
ADDRESSBOOK_NAME=

# Версия образов: latest, номер релиза (1.0) или edge. / Image tag: latest, a release or edge.
VISITKA_VERSION=latest

# Часовой пояс интерфейса и логов. / Time zone for the UI and logs.
TZ=Europe/Moscow

# Внутренняя подсеть Docker; смените, если 10.77.0.0/24 уже занята.
# Internal Docker subnet; change it if 10.77.0.0/24 is already in use.
CONTACTS_SUBNET=10.77.0.0/24

# Внутренний адрес Radicale (менять не нужно). / Internal Radicale address.
RADICALE_URL=http://radicale:5232
